{
  "name": "evidence-cv-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "contract:generate": "../.venv/bin/python ../backend/export_openapi.py openapi.json && openapi-typescript openapi.json --output src/generated/api-schema.ts --alphabetize",
    "contract:check": "../scripts/check_api_contract.sh",
    "lint": "eslint .",
    "test": "vitest",
    "e2e": "playwright test",
    "samples:pdf": "vite build --ssr scripts/generate-sample-pdfs.tsx --outDir .sample-pdf-build && node .sample-pdf-build/generate-sample-pdfs.js"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "globals": "17.4.0",
    "jsdom": "29.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
